{
  "name": "@bemedev/typings",
  "version": "1.4.1",
  "description": "Typings by variables",
  "keywords": [
    "typings",
    "typescript",
    "types"
  ],
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/typings.git"
  },
  "files": [
    "lib",
    "package.json"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "types": "./lib/index.d.ts"
    },
    "./helpers": {
      "import": "./lib/helpers/index.js",
      "require": "./lib/helpers/index.cjs",
      "types": "./lib/helpers/index.d.ts"
    },
    "./constants": {
      "import": "./lib/constants.js",
      "require": "./lib/constants.cjs",
      "types": "./lib/constants.d.ts"
    },
    "./package.json": "./package.json",
    "./tsconfig.json": "./tsconfig.json",
    "./types": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/types/index.js",
      "require": "./lib/types/index.cjs"
    },
    "./standard": {
      "types": "./lib/standard.d.ts",
      "import": "./lib/standard.js",
      "require": "./lib/standard.cjs"
    },
    "./utils/*": {
      "types": "./lib/utils/*.d.ts",
      "import": "./lib/utils/*.js",
      "require": "./lib/utils/*.cjs"
    }
  },
  "scripts": {
    "p-q": "pretty-quick",
    "posttest": "vp fmt",
    "pretest": "vp run pack",
    "rm:lib": "vp dlx rimraf ./lib",
    "test:coverage": "vp test run",
    "test": "vp run test:coverage --no-coverage",
    "test:only": "vp run test",
    "test:watch": "vp test"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "^1.5.2",
    "@size-limit/file": "^14.3.0",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "size-limit": [
    {
      "path": "lib/**/*.js",
      "limit": "10kb"
    },
    {
      "path": "lib/**/*.cjs",
      "limit": "10kb"
    },
    {
      "path": "lib/**/*.d.ts",
      "limit": "10kb"
    }
  ]
}
